# ─────────────────────────────────────────────────────────────────────────────
# .env — Docker Compose y variables PÚBLICAS del navegador (NEXT_PUBLIC_*).
# Este archivo se copia a la imagen y Next lo lee al compilar: NO pongas secretos
# aquí. Las variables privadas del servidor van en .env.tickets (excluido de la
# imagen y cargado por Compose al arrancar).
# Copia como .env y reemplaza los valores <…>. Tras cambiar un NEXT_PUBLIC_*,
# reconstruye la imagen (se fijan al compilar).
# Comprobar: pnpm entorno:check
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker Compose ──────────────────────────────────────────────────────────
# Servicio sistema-tickets-web: puerto publicado y del contenedor.
APP_PORT=3000
# Perfil qa (servicio panel → contenedor panel-vivi-qa):
# FRONT_PORT=4011
# QA_GRAPHQL_ENDPOINT=http://api-tickets-vivi-qa:3003/graphql
# TICKETS_VIVI_NETWORK=vivi-qa-cierre

# ── Navegador (públicas, se fijan al compilar) ──────────────────────────────
NEXT_PUBLIC_ENV=production
NEXT_PUBLIC_GRAPHQL_DEBUG=false
# Tiempo máximo de cada consulta del navegador (QA usa 30000 / 60000).
NEXT_PUBLIC_GRAPHQL_TIMEOUT_MS=8000
NEXT_PUBLIC_FETCH_TIMEOUT_MS=10000
# Cookie de sesión «Secure»: dejar sin definir (true) en HTTPS. false solo para probar por HTTP.
# NEXT_PUBLIC_AUTH_COOKIE_SECURE=false
# Turnstile remoto (panel-emetra).
NEXT_PUBLIC_TURNSTILE_EMBED_URL=https://panel-emetra.muniguate.com/app/turnstile
# Opcional: origen exacto para validar postMessage (por defecto, el de EMBED_URL).
# NEXT_PUBLIC_TURNSTILE_EMBED_ORIGIN=https://panel-emetra.muniguate.com
