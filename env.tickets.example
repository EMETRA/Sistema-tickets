# ─────────────────────────────────────────────────────────────────────────────
# .env.tickets — Variables PRIVADAS del servidor Next (no llegan al navegador ni
# a la imagen: .dockerignore lo excluye y Compose lo carga al arrancar).
# Copia como .env.tickets y reemplaza los valores <…>. Comprobar: pnpm entorno:check
# ─────────────────────────────────────────────────────────────────────────────

# ── api-tickets ─────────────────────────────────────────────────────────────
# GraphQL del API, dirección interna (el navegador siempre llama a /api/graphql).
# El perfil qa de Compose lo toma de QA_GRAPHQL_ENDPOINT en .env.
GRAPHQL_ENDPOINT=<http://api-tickets:3000/graphql>
# Alternativa: base del API (se agrega /graphql). GRAPHQL_ENDPOINT tiene prioridad.
# TICKETS_API_URL=http://api-tickets:3000
# Tiempo máximo del proxy /api/graphql en el servidor.
GRAPHQL_PROXY_TIMEOUT_MS=60000

# Panel institucional: catálogo autorizado, accesos por módulo y espacios de trabajo.
# Debe coincidir con TICKETS_PLATFORM_ENABLED de api-tickets. Con false, los módulos
# que verifican acceso quedan bloqueados.
TICKETS_PLATFORM_ENABLED=true

# ── Recuperación de contraseña ──────────────────────────────────────────────
# Base que termina en el prefijo /auth/ de api-autenticacion. Vacío = la página
# muestra «recuperación no disponible» sin simular envíos.
AUTH_RECOVERY_BASE_URL=<http://api-autenticacion:4000/auth/>

# ── Incidencias del Panel → api-tickets ─────────────────────────────────────
# Token aleatorio (32–200 caracteres). En api-tickets se configura su SHA-256 en
# TICKETS_PANEL_ERROR_TOKEN_SHA256. Generar: openssl rand -hex 32
TICKETS_PANEL_ERROR_TOKEN=<token-aleatorio>
# Cola local si el API no responde (Compose la monta en /var/lib/tickets-incidencias).
# TICKETS_ERROR_QUEUE_DIR=/var/lib/tickets-incidencias
