{
  "name": "sistema-tickets",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "laboratorio": "node scripts/laboratorio/iniciar.cjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "storybook": "storybook dev",
    "build-storybook": "storybook build",
    "test:integracion": "node --test test/integracion/*.test.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens": "node scripts/tokens/generar.cjs",
    "tokens:check": "node scripts/tokens/generar.cjs --check",
    "e2e": "playwright test",
    "e2e:instalar": "playwright install --with-deps chromium",
    "contrato": "node scripts/sincronizar-definiciones.cjs ${API_TICKETS_DIR:-../../apis/api-tickets} --check && node scripts/contrato-api.cjs ${API_TICKETS_DIR:-../../apis/api-tickets} && node scripts/contrato-graphql.cjs ${API_TICKETS_DIR:-../../apis/api-tickets}"
  },
  "dependencies": {
    "@hookform/resolvers": "^5",
    "@tanstack/react-query": "^5.108.4",
    "@tiptap/extension-strike": "^3.20.4",
    "@tiptap/extension-underline": "^3.20.4",
    "@tiptap/pm": "^3.20.4",
    "@tiptap/react": "^3.20.4",
    "@tiptap/starter-kit": "^3.20.4",
    "axios": "^1.13.5",
    "classnames": "^2.5.1",
    "graphql": "^16.13.1",
    "graphql-request": "^7.4.0",
    "js-cookie": "^3.0.5",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7",
    "react-turnstile": "^1.1.5",
    "recharts": "^3.7.0",
    "sass": "^1.98.0",
    "tiptap-markdown": "^0.9.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.2.8",
    "@storybook/nextjs-vite": "^10.2.8",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.2.8",
    "playwright": "^1.53.2",
    "prettier": "^3.10.1",
    "sass-embedded": "^1.97.3",
    "storybook": "^10.2.8",
    "typescript": "^5",
    "vite": "^7.3.1"
  }
}
