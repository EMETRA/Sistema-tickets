# Usar como referencia; conservar el resto de la configuración local.
# Direcciones privadas usadas únicamente por el servidor del Panel.
GRAPHQL_ENDPOINT=http://api-tickets-vivi-qa:3003/graphql
API_PORTAL_URL=http://api-portal-vivi-qa:4001
NEXT_PUBLIC_GRAPHQL_DEBUG=false
NEXT_PUBLIC_GRAPHQL_TIMEOUT_MS=30000
NEXT_PUBLIC_FETCH_TIMEOUT_MS=60000
GRAPHQL_PROXY_TIMEOUT_MS=60000
# Solo para probar este contenedor por HTTP. En el sitio HTTPS usar true.
# Los NEXT_PUBLIC_* se incorporan al compilar: reconstruir tras cambiarlos.
NEXT_PUBLIC_AUTH_COOKIE_SECURE=false
