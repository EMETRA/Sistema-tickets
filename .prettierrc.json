{
  "printWidth": 110,
  "tabWidth": 4,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    { "files": ["*.scss", "*.css"], "options": { "tabWidth": 2 } },
    { "files": ["*.json", "*.yml", "*.yaml"], "options": { "tabWidth": 2 } }
  ]
}
